<!-- Base application theme. Activity uses Compose, so this is minimal.
     Compose handles all visual theming via NomadHandheldTheme. -->
<resources>
    <style name="Theme.NomadHandheld" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Window background matches our dark theme to avoid white flash on startup -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
